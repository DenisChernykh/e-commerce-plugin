{
  "name": "@tiho/chatgpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && node --env-file-if-exists=.env scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "tsx --test src/*.test.ts",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tiho/backend": "workspace:*",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}

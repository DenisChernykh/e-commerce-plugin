# Local D1 and storefront. No model API, bank or card credentials.
CATALOG_API_URL=http://127.0.0.1:8787
STORE_URL=http://localhost:3000
PORT=8790
MCP_AUTH_MODE=local
DEV_MCP_USER=local-checkout-review
# Same locally generated value as backend/.dev.vars. Never ship it in a bundle.
TIHO_MCP_SECRET=replace-with-a-random-secret-at-least-32-characters
# Private Sites: MCP_AUTH_MODE=sites, omit DEV_MCP_USER, set the presentation
# API, protected STORE_URL and a separate TIHO_MCP_SECRET through runtime settings.

{
  "openapi": "3.1.0",
  "info": {
    "title": "TIHO Catalog API",
    "version": "0.1.0",
    "description": "Public read-only lifestyle catalog. Stable UUIDs and slugs, structured attributes, search and composable filters. Prices are RUB. No authentication required."
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ]
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "pageSize",
              "total",
              "totalPages"
            ]
          }
        },
        "required": [
          "items",
          "pagination"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "Price in RUB, up to two decimal places. Stored as integer kopecks.",
            "example": 2400
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "brand": {
            "$ref": "#/components/schemas/Brand"
          },
          "color": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "slug",
              "name",
              "hex"
            ]
          },
          "material": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "name"
            ]
          },
          "type": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "name"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "in_stock",
              "out_of_stock"
            ]
          },
          "featured": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImage"
            }
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductAttribute"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "sku",
          "name",
          "description",
          "shortDescription",
          "price",
          "currency",
          "category",
          "brand",
          "color",
          "material",
          "type",
          "availability",
          "featured",
          "createdAt",
          "images",
          "attributes"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "slug",
          "name",
          "id",
          "description",
          "position"
        ]
      },
      "Brand": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "id",
          "description"
        ]
      },
      "ProductImage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "alt": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "url",
          "alt",
          "position"
        ]
      },
      "ProductAttribute": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "name",
          "value",
          "label",
          "unit"
        ]
      },
      "CatalogFacets": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "hex": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "name",
                "count"
              ]
            }
          },
          "brands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "hex": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "name",
                "count"
              ]
            }
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "hex": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "name",
                "count"
              ]
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "hex": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "name",
                "count"
              ]
            }
          },
          "types": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "hex": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "name",
                "count"
              ]
            }
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "maxLength": 100,
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer"
                      },
                      "hex": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "name",
                      "count"
                    ]
                  }
                }
              },
              "required": [
                "key",
                "name",
                "options"
              ]
            }
          },
          "price": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "enum": [
                  "RUB"
                ]
              }
            },
            "required": [
              "min",
              "max",
              "currency"
            ]
          }
        },
        "required": [
          "categories",
          "brands",
          "colors",
          "materials",
          "types",
          "attributes",
          "price"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Worker liveness; does not query the database",
        "responses": {
          "200": {
            "description": "Worker is available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "revision": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "revision"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Runtime configuration error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "operationId": "listProducts",
        "tags": [
          "Catalog"
        ],
        "summary": "Search, filter and paginate the catalog",
        "description": "Public read-only catalog. Multiple values within a filter are OR; different filters are AND. Price bounds are inclusive RUB. Sorting always includes a stable ID tie-breaker. Pages beyond the last return an empty items array with the correct total.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 160,
              "description": "Case-insensitive literal substring search across name, description, brand, category and attributes. All words must match; maximum 8 words.",
              "example": "соевая свеча"
            },
            "required": false,
            "description": "Case-insensitive literal substring search across name, description, brand, category and attributes. All words must match; maximum 8 words.",
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 800,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*){0,9}$",
              "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
              "example": "candles,ceramics"
            },
            "required": false,
            "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
            "name": "category",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 800,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*){0,9}$",
              "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
              "example": "candles,ceramics"
            },
            "required": false,
            "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
            "name": "brand",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 800,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*){0,9}$",
              "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
              "example": "candles,ceramics"
            },
            "required": false,
            "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
            "name": "color",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 800,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*){0,9}$",
              "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
              "example": "candles,ceramics"
            },
            "required": false,
            "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
            "name": "material",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 800,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*){0,9}$",
              "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
              "example": "candles,ceramics"
            },
            "required": false,
            "description": "Comma-separated slugs (maximum 10). OR within this field; AND across different fields.",
            "name": "type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[a-z0-9-]+:[a-z0-9-]+(?:,[a-z0-9-]+:[a-z0-9-]+){0,7}$",
              "description": "key:value pairs separated by commas. OR for the same key; AND across keys. Discover keys/values with /api/catalog/facets.",
              "example": "aroma:woody,aroma:floral,volume:200"
            },
            "required": false,
            "description": "key:value pairs separated by commas. OR for the same key; AND across keys. Discover keys/values with /api/catalog/facets.",
            "name": "attribute",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 99999999.99,
              "example": 1000,
              "description": "Inclusive price in RUB, up to two decimal places."
            },
            "required": false,
            "description": "Inclusive price in RUB, up to two decimal places.",
            "name": "priceFrom",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 99999999.99,
              "example": 1000,
              "description": "Inclusive price in RUB, up to two decimal places."
            },
            "required": false,
            "description": "Inclusive price in RUB, up to two decimal places.",
            "name": "priceTo",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "in_stock",
                "out_of_stock"
              ]
            },
            "required": false,
            "name": "availability",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "featured",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "price_asc",
                "price_desc",
                "newest",
                "name_asc"
              ],
              "default": "recommended"
            },
            "required": false,
            "name": "sort",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 48,
              "default": 12
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching products and pagination metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/path. Unknown query fields and malformed filters are rejected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Resource does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{identifier}": {
      "get": {
        "operationId": "getProduct",
        "tags": [
          "Catalog"
        ],
        "summary": "Get a product by UUID or slug",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z0-9-]+$",
              "description": "Stable product UUID or human-readable slug.",
              "example": "candle-quiet-morning"
            },
            "required": true,
            "description": "Stable product UUID or human-readable slug.",
            "name": "identifier",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Full structured product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/path. Unknown query fields and malformed filters are rejected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Resource does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{identifier}/related": {
      "get": {
        "operationId": "getRelatedProducts",
        "tags": [
          "Catalog"
        ],
        "summary": "Products from the same category, excluding the current product",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z0-9-]+$",
              "description": "Stable product UUID or human-readable slug.",
              "example": "candle-quiet-morning"
            },
            "required": true,
            "description": "Stable product UUID or human-readable slug.",
            "name": "identifier",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "default": 4
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Available products first, then editorial ranking",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/path. Unknown query fields and malformed filters are rejected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Resource does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "operationId": "listCategories",
        "tags": [
          "Metadata"
        ],
        "summary": "All categories in display order",
        "responses": {
          "200": {
            "description": "Catalog categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",

{
  "name": "@tiho/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "api:sync": "tsx scripts/openapi/sync-openapi.ts",
    "api:generate": "orval && prettier --write src/shared/api/generated",
    "api:update": "pnpm api:sync && pnpm api:generate",
    "api:check": "tsx scripts/openapi/check-openapi.ts",
    "check": "pnpm format:check && pnpm lint && pnpm architecture && pnpm typecheck && pnpm test && pnpm build",
    "build:chatgpt": "vite build --config vite.chatgpt.config.ts",
    "prebuild": "node ../chatgpt/scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.8",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "orval": "8.23.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.15.0",
    "steiger": "0.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.11",
    "vite": "8.1.5",
    "@tailwindcss/vite": "4.3.3"
  }
}

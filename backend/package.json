{
  "name": "@tiho/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "typegen": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings",
    "typegen:check": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --check",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "boundaries:check": "node scripts/check-module-boundaries.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tiho-catalog --local",
    "db:migrate:remote": "wrangler d1 migrations apply tiho-catalog --remote --env production",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "db:seed:remote": "tsx scripts/seed.ts --remote",
    "deploy:dry-run": "wrangler deploy --dry-run --env=",
    "deploy": "wrangler deploy --env production",
    "check": "pnpm typegen:check && pnpm format:check && pnpm boundaries:check && pnpm typecheck && pnpm test && pnpm deploy:dry-run"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "exports": {
    "./catalog-contracts": "./src/modules/catalog/public-contracts.ts",
    "./commerce-contracts": "./src/modules/commerce/public-contracts.ts"
  }
}
